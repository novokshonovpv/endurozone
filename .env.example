# Development defaults. Run from repository root using pnpm dev.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Optional: PostgreSQL server instead of embedded local PGlite.
# DATABASE_URL=postgresql://enduro:change-me@localhost:5432/enduro
# COOKIE_SECURE=true

# Development: files only, no external email delivery.
MAIL_MODE=file
REQUIRE_VERIFIED_EMAIL=false
# Production requires REQUIRE_VERIFIED_EMAIL=true and MAIL_MODE=smtp.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-username
# SMTP_PASSWORD=your-secret
# MAIL_FROM=Enduro.Zone <noreply@your-owned-domain.example>
# For port 587 set SMTP_SECURE=false; STARTTLS is still required.

# Optional AI mechanic: server-side secrets only, never in VITE_* variables, Git or chat.
# MECHANIC_PROVIDER picks one of openai | yandex | gigachat; without it the first
# fully configured provider below is used. Nothing configured: the mechanic stays off.
# MECHANIC_PROVIDER=yandex
#
# OpenAI (not reachable from servers in Russia):
# OPENAI_API_KEY=your-server-secret
# OPENAI_MODEL=your-enabled-model-id
#
# YandexGPT (Yandex Cloud, service account with ai.languageModels.user):
# YANDEX_API_KEY=your-service-account-api-key
# YANDEX_FOLDER_ID=your-folder-id
# YANDEX_MODEL=yandexgpt-lite/latest
#
# GigaChat (Sber): authorization key from the developer cabinet.
# GIGACHAT_AUTH_KEY=your-authorization-key
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# Sber endpoints use the Russian Trusted Root CA; point Node at it:
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/russian_trusted_root_ca.crt
