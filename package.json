{
  "name": "enduro-zone",
  "version": "0.21.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @enduro/api dev",
    "dev:web": "pnpm --filter @enduro/web dev",
    "check": "pnpm -r typecheck",
    "test": "pnpm --filter @enduro/api test",
    "build": "pnpm --filter @enduro/web build",
    "start": "pnpm --filter @enduro/api start",
    "api:export": "pnpm --filter @enduro/api export:api",
    "moderator": "pnpm --filter @enduro/api moderator",
    "mechanic:eval": "node --env-file-if-exists=.env.mechanic apps/api/node_modules/tsx/dist/cli.mjs deploy/mechanic-eval.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
